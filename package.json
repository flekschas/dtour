{
  "name": "dtour-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a",
  "scripts": {
    "build": "pnpm -r build",
    "predev": "pnpm --filter @dtour/viewer build",
    "dev": "pnpm --parallel --filter @dtour/viewer --filter webapp dev",
    "lint:js": "biome check .",
    "lint:py": "uvx ruff check --config packages/python/pyproject.toml packages/python/",
    "lint": "pnpm run lint:js && pnpm run lint:py",
    "format": "biome check --write . && uvx ruff check --fix --config packages/python/pyproject.toml packages/python/ && uvx ruff format --config packages/python/pyproject.toml packages/python/",
    "bench": "pnpm --filter benchmarks bench",
    "test:notebooks": "bash scripts/test-notebooks.sh",
    "bump": "bash scripts/bump.sh",
    "prepare": "lefthook install"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "core-js",
      "esbuild",
      "lefthook",
      "msw"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "lefthook": "^2.1.4",
    "shadcn": "^3.8.5",
    "typescript": "^5.7.3"
  }
}
